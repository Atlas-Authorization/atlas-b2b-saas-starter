# Atlas B2B SaaS starter — copy to .env.local and fill in your instance's values.

# Publishable key (safe to expose to the browser).
NEXT_PUBLIC_ATLAS_PUBLISHABLE_KEY=pk_test_xxx

# The instance's Frontend API origin.
NEXT_PUBLIC_ATLAS_FRONTEND_API=https://atlasauth.net

# Edge JWT verification (middleware + server auth()).
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net

# Server-only secret key — needed for the member list (Backend API). NEVER
# prefix with NEXT_PUBLIC_. Leave unset to run without the member list.
# ATLAS_SECRET_KEY=sk_test_xxx
# ATLAS_API_URL=https://api.atlasauth.net
